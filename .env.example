# true(기본) 또는 비워두면 목업 서버(src/api/mock)로 동작합니다.
# 백엔드와 연결하려면 false로 바꾸세요.
VITE_USE_MOCK=true

# 백엔드 주소. 비워두면 같은 도메인의 /api, /auth 로 요청합니다 (권장: Vercel·Vite 프록시 사용).
# 세션 쿠키가 SameSite=Lax라서 다른 도메인으로 직접 요청하면 로그인이 유지되지 않을 수 있습니다.
VITE_API_ORIGIN=

# 로컬 개발 시 /api, /auth 요청을 넘길 백엔드 주소 (예: http://localhost:8080)
VITE_API_PROXY=
